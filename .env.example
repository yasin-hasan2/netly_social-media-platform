# Server Configuration
PORT=3000

# Database (optional - if omitted, Net-ly runs using in-memory store)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/netly

# Authentication
JWT_SECRET_KEY=netly_jwt_secret_dev_key

# Cloudinary (optional - for external media hosting, defaults to inline data URIs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client / Socket URLs (optional, defaults to same-origin / relative)
CLIENT_URL=http://localhost:3000
VITE_API_URL=
VITE_SOCKET_URL=

# Nodemailer / Email Service (optional - auto-generates Ethereal test account if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Net-ly Support <support@netly.app>"

